<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.InspectionEnforceLawReportMapper">
    <!-- author: Samer  执法检查报告-->

    <!-- 获取记录 -->
    <select id="getRecord" resultType="java.util.HashMap">
        SELECT *,false AS isSet
        FROM
        `inspection`.`inspection_enforce_law_report` a
        WHERE 1=1
        <if test='params.FF_ID != null and params.FF_ID != ""'>
            AND a.REPORT_ID = #{params.REPORT_ID}
        </if>
        <if test='params.TASK_ID != null and params.TASK_ID != ""'>
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
        <if test='params.DEPARTMENT != null and params.DEPARTMENT != ""'>
            AND a.DEPARTMENT = #{params.DEPARTMENT}
        </if>
        <if test='params.RECORD_TYPE != null and params.RECORD_TYPE != ""'>
            AND a.RECORD_TYPE = #{params.RECORD_TYPE}
        </if>
    </select>

    <!-- 修改记录 -->
    <update id="editRecord">
        UPDATE `inspection`.`inspection_enforce_law_report`
        SET
        <if test=' params.TASK_ID != null and params.TASK_ID != "" '>
            TASK_ID = #{params.TASK_ID},
        </if>
        <if test=' params.DEPARTMENT != null and params.DEPARTMENT != "" '>
            DEPARTMENT = #{params.DEPARTMENT},
        </if>
        <if test=' params.CHECKED_ORG_DSCR != null and params.CHECKED_ORG_DSCR != "" '>
            CHECKED_ORG_DSCR = #{params.CHECKED_ORG_DSCR},
        </if>
        <if test=' params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != "" '>
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=' params.INSPECT_ITEM_DSCR != null and params.INSPECT_ITEM_DSCR != "" '>
            INSPECT_ITEM_DSCR = #{params.INSPECT_ITEM_DSCR},
        </if>
        <if test=' params.INSPECT_DATE != null and params.INSPECT_DATE != "" '>
            INSPECT_DATE=#{params.INSPECT_DATE},
        </if>
        <if test=' params.SUGGESTION_BASIS != null and params.SUGGESTION_BASIS != "" '>
            SUGGESTION_BASIS=#{params.SUGGESTION_BASIS},
        </if>
        <if test=' params.MEMBER != null and params.MEMBER != "" '>
            MEMBER = #{params.MEMBER},
        </if>
        <if test=' params.GROUP_LEADER != null and params.GROUP_LEADER != "" '>
            GROUP_LEADER=#{params.GROUP_LEADER},
        </if>
        <if test=' params.LAW_DEP_OPINION != null and params.LAW_DEP_OPINION != "" '>
            LAW_DEP_OPINION=#{params.LAW_DEP_OPINION},
        </if>
        <if test=' params.LAW_DEP_HEAD != null and params.LAW_DEP_HEAD != "" '>
            LAW_DEP_HEAD=#{params.LAW_DEP_HEAD},
        </if>
        <if test=' params.LAW_LEADER_OPINION != null and params.LAW_LEADER_OPINION != "" '>
            LAW_LEADER_OPINION=#{params.LAW_LEADER_OPINION},
        </if>
        <if test=' params.LAW_LEADER != null and params.LAW_LEADER != "" '>
            LAW_LEADER=#{params.LAW_LEADER},
        </if>
        <if test=' params.FILLING_DATE != null and params.FILLING_DATE != "" '>
            FILLING_DATE=#{params.FILLING_DATE},
        </if>
        <if test=' params.ADD_USERID != null and params.ADD_USERID != "" '>
            ADD_USERID = #{params.ADD_USERID},
        </if>
        <if test=' params.ADD_DATE != null and params.ADD_DATE != "" '>
            ADD_DATE = #{params.ADD_DATE},
        </if>
        <if test=' params.MODIFY_USERID != null and params.MODIFY_USERID != "" '>
            MODIFY_USERID = #{params.MODIFY_USERID},
        </if>
        <if test=' params.MODIFY_DATE != null and params.MODIFY_DATE != "" '>
            MODIFY_DATE = #{params.MODIFY_DATE},
        </if>
        <if test=' params.ATTACHMENT_NAME != null and params.ATTACHMENT_NAME != "" '>
            ATTACHMENT_NAME = #{params.ATTACHMENT_NAME},
        </if>
        <if test=' params.PAPER_ATTACHMENT != null and params.PAPER_ATTACHMENT != "" '>
            PAPER_ATTACHMENT = #{params.PAPER_ATTACHMENT},
        </if>
        <if test=' params.PRINT_ATTACHMENT != null and params.PRINT_ATTACHMENT != "" '>
            PRINT_ATTACHMENT = #{params.PRINT_ATTACHMENT},
        </if>
        REPORT_ID = #{params.REPORT_ID}
        WHERE
        REPORT_ID = #{params.REPORT_ID}
    </update>

    <!-- 新增记录 -->
    <insert id="addRecord">
        INSERT INTO `inspection`.`inspection_enforce_law_report`
        VALUES (
            #{params.REPORT_ID},
            #{params.TASK_ID},
            #{params.DEPARTMENT},
            #{params.CHECKED_ORG_DSCR},
            #{params.CHECK_ORG_DSCR},
            #{params.INSPECT_ITEM_DSCR},
            #{params.INSPECT_DATE},
            #{params.SUGGESTION_BASIS},
            #{params.MEMBER},
            #{params.GROUP_LEADER},
            #{params.LAW_DEP_OPINION},
            #{params.LAW_DEP_HEAD},
            #{params.LAW_LEADER_OPINION},
            #{params.LAW_LEADER},
            #{params.FILLING_DATE},
            #{params.ADD_USERID},
            #{params.ADD_DATE},
            #{params.MODIFY_USERID},
            #{params.MODIFY_DATE},
            #{params.ATTACHMENT_NAME},
            #{params.PAPER_ATTACHMENT},
            #{params.PRINT_ATTACHMENT}
        )
    </insert>

</mapper>