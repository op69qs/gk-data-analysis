<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.MeetingMinutesMapper">

    <select id="getMeetingMinutesData" resultType="java.util.Map">
        SELECT
        *
        FROM
        inspection.inspection_meeting_minutes a
        WHERE
        1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND a.ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID!='' ">
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
    </select>

    <insert id="addMeetingMinutes" >
        INSERT INTO inspection.inspection_meeting_minutes
        VALUES
        (
        #{params.ID},
        #{params.CHECK_ORG_DSCR},
        #{params.MEETING_TIME},
        #{params.CHECKED_ORG_DSCR},
        #{params.CHECKED_MEMBER},
        #{params.MEMBER},
        #{params.MEETING_CONTENT},
        #{params.HEAD},
        #{params.LARDER},
        #{params.RECORDER},
        #{params.TASK_ID},
        #{params.FILE_PATH}
        )
    </insert>

    <update id="editMeetingMinutes">
        UPDATE inspection.inspection_meeting_minutes SET
        <if test=" params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != ''">
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=" params.CHECKED_ORG_DSCR != null and params.CHECKED_ORG_DSCR != ''">
            CHECKED_ORG_DSCR = #{params.CHECKED_ORG_DSCR},
        </if>
        <if test=" params.MEETING_TIME != null and params.MEETING_TIME != ''">
            MEETING_TIME = #{params.MEETING_TIME},
        </if>
        <if test=" params.CHECKED_MEMBER != null and params.CHECKED_MEMBER != ''">
            CHECKED_MEMBER = #{params.CHECKED_MEMBER},
        </if>
        <if test=" params.MEMBER != null and params.MEMBER != ''">
            MEMBER = #{params.MEMBER},
        </if>
        <if test=" params.LARDER != null and params.LARDER != ''">
            LARDER = #{params.LARDER},
        </if>
        <if test=" params.HEAD != null and params.HEAD != ''">
            HEAD = #{params.HEAD},
        </if>
        <if test=" params.RECORDER != null and params.RECORDER != ''">
            RECORDER = #{params.RECORDER},
        </if>
        <if test=" params.MEETING_CONTENT != null and params.MEETING_CONTENT != ''">
            MEETING_CONTENT = #{params.MEETING_CONTENT},
        </if>
        <if test=" params.FILE_PATH != null and params.FILE_PATH != ''">
            FILE_PATH = #{params.FILE_PATH},
        </if>
        ID = #{params.ID}
        WHERE ID = #{params.ID}
    </update>

    <delete id="delMeetingMinutes" >
        DELETE
        FROM
        inspection.inspection_meeting_minutes
        WHERE 1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID != ''">
            AND TASK_ID = #{params.TASK_ID}
        </if>
    </delete>

</mapper>