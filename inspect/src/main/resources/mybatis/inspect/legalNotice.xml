<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.LegalNoticeMapper">

    <select id="getLegalNoticeData" resultType="java.util.Map">
        SELECT
        *
        FROM
        inspection.inspection_legal_notice a
        WHERE
        1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND a.ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID!='' ">
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
    </select>

    <insert id="addLegalNotice" >
        INSERT INTO inspection.inspection_legal_notice
        VALUES
        (
        #{params.ID},
        #{params.CHECK_ORG_DSCR},
        #{params.VALUE_1},
        #{params.VALUE_2},
        #{params.NUM},
        #{params.CHECKED_ORG_DSCR},
        #{params.BASIS},
        #{params.CONTENT},
        #{params.TERM},
        #{params.CHECK_TIME},
        #{params.MEMBER},
        #{params.LARDER},
        #{params.CHIEF},
        #{params.OTHER_MEMBER},
        #{params.NOTICE_TIME},
        #{params.TASK_ID},
        #{params.FILE_PATH}
        )
    </insert>

    <update id="editLegalNotice">
        UPDATE inspection.inspection_legal_notice SET
        <if test=" params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != ''">
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=" params.VALUE_1 != null and params.VALUE_1 != ''">
            VALUE_1 = #{params.VALUE_1},
        </if>
        <if test=" params.VALUE_2 != null and params.VALUE_2 != ''">
            VALUE_2 = #{params.VALUE_2},
        </if>
        <if test=" params.NUM != null and params.NUM != ''">
            NUM = #{params.NUM},
        </if>
        <if test=" params.CHECKED_ORG_DSCR != null and params.CHECKED_ORG_DSCR != ''">
            CHECKED_ORG_DSCR = #{params.CHECKED_ORG_DSCR},
        </if>
        <if test=" params.BASIS != null and params.BASIS != ''">
            BASIS = #{params.BASIS},
        </if>
        <if test=" params.CONTENT != null and params.CONTENT != ''">
            CONTENT = #{params.CONTENT},
        </if>
        <if test=" params.TERM != null and params.TERM != ''">
            TERM = #{params.TERM},
        </if>
        <if test=" params.CHECK_TIME != null and params.CHECK_TIME != ''">
            CHECK_TIME = #{params.CHECK_TIME},
        </if>
        <if test=" params.MEMBER != null and params.MEMBER != ''">
            MEMBER = #{params.MEMBER},
        </if>
        <if test=" params.LARDER != null and params.LARDER != ''">
            LARDER = #{params.LARDER},
        </if>
        <if test=" params.CHIEF != null and params.CHIEF != ''">
            CHIEF = #{params.CHIEF},
        </if>
        <if test=" params.OTHER_MEMBER != null and params.OTHER_MEMBER != ''">
            OTHER_MEMBER = #{params.OTHER_MEMBER},
        </if>
        <if test=" params.NOTICE_TIME != null and params.NOTICE_TIME != ''">
            NOTICE_TIME = #{params.NOTICE_TIME},
        </if>
        <if test=" params.FILE_PATH != null and params.FILE_PATH != ''">
            FILE_PATH = #{params.FILE_PATH},
        </if>
        ID = #{params.ID}
        WHERE ID = #{params.ID}
    </update>

    <delete id="delLegalNotice" >
        DELETE
        FROM
        inspection.inspection_legal_notice
        WHERE 1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID != ''">
            AND TASK_ID = #{params.TASK_ID}
        </if>
    </delete>

</mapper>