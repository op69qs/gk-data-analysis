<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.EntryRecordMapper">

    <select id="getEntryRecordData" resultType="java.util.Map">
        SELECT
        *
        FROM
        inspection.inspection_entry_record a
        WHERE
        1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND a.ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID!='' ">
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
    </select>

    <insert id="addEntryRecord" >
        INSERT INTO inspection.inspection_entry_record
        VALUES
        (
        #{params.ID},
        #{params.CHECK_ORG_DSCR},
        #{params.CHECKED_ORG_DSCR},
        #{params.ENTRY_TIME},
        #{params.ENTRY_ADDRESS},
        #{params.MEMBER},
        #{params.HEAD},
        #{params.LARDER},
        #{params.RECORDER},
        #{params.RECORD_TIME},
        #{params.TASK_ID},
        #{params.FILE_PATH}
        )
    </insert>

    <update id="editEntryRecord">
        UPDATE inspection.inspection_entry_record SET
        <if test=" params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != ''">
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=" params.CHECKED_ORG_DSCR != null and params.CHECKED_ORG_DSCR != ''">
            CHECKED_ORG_DSCR = #{params.CHECKED_ORG_DSCR},
        </if>
        <if test=" params.ENTRY_TIME != null and params.ENTRY_TIME != ''">
            ENTRY_TIME = #{params.ENTRY_TIME},
        </if>
        <if test=" params.ENTRY_ADDRESS != null and params.ENTRY_ADDRESS != ''">
            ENTRY_ADDRESS = #{params.ENTRY_ADDRESS},
        </if>
        <if test=" params.MEMBER != null and params.MEMBER != ''">
            MEMBER = #{params.MEMBER},
        </if>
        <if test=" params.LARDER != null and params.LARDER != ''">
            LARDER = #{params.LARDER},
        </if>
        <if test=" params.HEAD != null and params.HEAD != ''">
            HEAD = #{params.HEAD},
        </if>
        <if test=" params.RECORDER != null and params.RECORDER != ''">
            RECORDER = #{params.RECORDER},
        </if>
        <if test=" params.RECORD_TIME != null and params.RECORD_TIME != ''">
            RECORD_TIME = #{params.RECORD_TIME},
        </if>
        <if test=" params.FILE_PATH != null and params.FILE_PATH != ''">
            FILE_PATH = #{params.FILE_PATH},
        </if>
        ID = #{params.ID}
        WHERE ID = #{params.ID}
    </update>

    <delete id="delEntryRecord" >
        DELETE
        FROM
        inspection.inspection_entry_record
        WHERE 1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID != ''">
            AND TASK_ID = #{params.TASK_ID}
        </if>
    </delete>

</mapper>