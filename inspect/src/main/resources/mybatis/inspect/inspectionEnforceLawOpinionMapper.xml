<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.InspectionEnforceLawOpinionMapper">
    <!-- author: Samer  执法检查意见书 -->

    <!-- 获取记录 -->
    <select id="getRecord" resultType="java.util.HashMap">
        SELECT *,false AS isSet
        FROM
        `inspection`.`inspection_enforce_law_opinion` a
        WHERE 1=1
        <if test='params.OP_ID != null and params.OP_ID != ""'>
            AND a.OP_ID = #{params.OP_ID}
        </if>
        <if test='params.TASK_ID != null and params.TASK_ID != ""'>
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
        <if test='params.DEPARTMENT != null and params.DEPARTMENT != ""'>
            AND a.DEPARTMENT = #{params.DEPARTMENT}
        </if>
        <if test='params.RECORD_TYPE != null and params.RECORD_TYPE != ""'>
            AND a.RECORD_TYPE = #{params.RECORD_TYPE}
        </if>
    </select>

    <!-- 修改记录 -->
    <update id="editRecord">
        UPDATE `inspection`.`inspection_enforce_law_opinion`
        SET
        <if test=' params.TASK_ID != null and params.TASK_ID != "" '>
            TASK_ID = #{params.TASK_ID},
        </if>
        <if test=' params.DEPARTMENT != null and params.DEPARTMENT != "" '>
            DEPARTMENT = #{params.DEPARTMENT},
        </if>
        <if test=' params.CHECKED_ORG_DSCR != null and params.CHECKED_ORG_DSCR != "" '>
            CHECKED_ORG_DSCR = #{params.CHECKED_ORG_DSCR},
        </if>
        <if test=' params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != "" '>
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=' params.ORG_ABB != null and params.ORG_ABB != "" '>
            ORG_ABB= #{params.ORG_ABB},
        </if>
        <if test=' params.ORG_ABB_SUB != null and params.ORG_ABB_SUB != "" '>
            ORG_ABB_SUB=#{params.ORG_ABB_SUB},
        </if>
        <if test=' params.OPINION_NO != null and params.OPINION_NO != "" '>
            OPINION_NO= #{params.OPINION_NO},
        </if>
        <if test=' params.CHECK_PERIOD_START != null and params.CHECK_PERIOD_START != "" '>
            CHECK_PERIOD_START=#{params.CHECK_PERIOD_START},
        </if>
        <if test=' params.CHECK_PERIOD_END != null and params.CHECK_PERIOD_END != "" '>
            CHECK_PERIOD_END= #{params.CHECK_PERIOD_END},
        </if>
        <if test=' params.ENFORCE_LAW_BASE != null and params.ENFORCE_LAW_BASE != "" '>
            ENFORCE_LAW_BASE=#{params.ENFORCE_LAW_BASE},
        </if>
        <if test=' params.NOT_OTHER_CONTENT != null and params.NOT_OTHER_CONTENT != "" '>
            NOT_OTHER_CONTENT=#{params.NOT_OTHER_CONTENT},
        </if>
        <if test=' params.OTHER_CONTENT != null and params.OTHER_CONTENT != "" '>
            OTHER_CONTENT=#{params.OTHER_CONTENT},
        </if>
        <if test=' params.LAW_OPINION != null and params.LAW_OPINION != "" '>
            LAW_OPINION=#{params.LAW_OPINION},
        </if>
        <if test=' params.REPORT_DATE != null and params.REPORT_DATE != "" '>
            REPORT_DATE=#{params.REPORT_DATE},
        </if>
        <if test=' params.FILLING_DATE != null and params.FILLING_DATE != "" '>
            FILLING_DATE=#{params.FILLING_DATE},
        </if>
        <if test=' params.ADD_USERID != null and params.ADD_USERID != "" '>
            ADD_USERID = #{params.ADD_USERID},
        </if>
        <if test=' params.ADD_DATE != null and params.ADD_DATE != "" '>
            ADD_DATE = #{params.ADD_DATE},
        </if>
        <if test=' params.MODIFY_USERID != null and params.MODIFY_USERID != "" '>
            MODIFY_USERID = #{params.MODIFY_USERID},
        </if>
        <if test=' params.MODIFY_DATE != null and params.MODIFY_DATE != "" '>
            MODIFY_DATE = #{params.MODIFY_DATE},
        </if>
        <if test=' params.ATTACHMENT_NAME != null and params.ATTACHMENT_NAME != "" '>
            ATTACHMENT_NAME = #{params.ATTACHMENT_NAME},
        </if>
        <if test=' params.PAPER_ATTACHMENT != null and params.PAPER_ATTACHMENT != "" '>
            PAPER_ATTACHMENT = #{params.PAPER_ATTACHMENT},
        </if>
        <if test=' params.PRINT_ATTACHMENT != null and params.PRINT_ATTACHMENT != "" '>
            PRINT_ATTACHMENT = #{params.PRINT_ATTACHMENT},
        </if>
        OP_ID = #{params.OP_ID}
        WHERE
        OP_ID = #{params.OP_ID}
    </update>

    <!-- 新增记录 -->
    <insert id="addRecord">
        INSERT INTO `inspection`.`inspection_enforce_law_opinion`
        VALUES (
            #{params.OP_ID},
            #{params.TASK_ID},
            #{params.DEPARTMENT},
            #{params.CHECK_ORG_DSCR},
            #{params.CHECKED_ORG_DSCR},
            #{params.ORG_ABB},
            #{params.ORG_ABB_SUB},
            #{params.OPINION_NO},
            #{params.CHECK_PERIOD_START},
            #{params.CHECK_PERIOD_END},
            #{params.ENFORCE_LAW_BASE},
            #{params.NOT_OTHER_CONTENT},
            #{params.OTHER_CONTENT},
            #{params.LAW_OPINION},
            #{params.REPORT_DATE},
            #{params.FILLING_DATE},
            #{params.ADD_USERID},
            #{params.ADD_DATE},
            #{params.MODIFY_USERID},
            #{params.MODIFY_DATE},
            #{params.ATTACHMENT_NAME},
            #{params.PAPER_ATTACHMENT},
            #{params.PRINT_ATTACHMENT}
        )
    </insert>

</mapper>