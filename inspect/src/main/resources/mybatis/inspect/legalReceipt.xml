<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.inspect.dao.mapper.inspect.LegalReceiptMapper">

    <select id="getLegalReceiptData" resultType="java.util.Map">
        SELECT
        *
        FROM
        inspection.inspection_legal_receipt a
        WHERE
        1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND a.ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID!='' ">
            AND a.TASK_ID = #{params.TASK_ID}
        </if>
    </select>

    <insert id="addLegalReceipt" >
        INSERT INTO inspection.inspection_legal_receipt
        VALUES
        (
        #{params.ID},
        #{params.CHECK_ORG_DSCR},
        #{params.SERVED_UNIT},
        #{params.SERVED_ADDRESS},
        #{params.SERVED_FILE},
        #{params.SERVED_SIGN},
        #{params.SERVED_TIME},
        #{params.SEND_SIGN},
        #{params.REASON},
        #{params.MEMO},
        #{params.TASK_ID},
        #{params.FILE_PATH}
        )
    </insert>

    <update id="editLegalReceipt">
        UPDATE inspection.inspection_legal_receipt SET
        <if test=" params.CHECK_ORG_DSCR != null and params.CHECK_ORG_DSCR != ''">
            CHECK_ORG_DSCR = #{params.CHECK_ORG_DSCR},
        </if>
        <if test=" params.SERVED_UNIT != null and params.SERVED_UNIT != ''">
            SERVED_UNIT = #{params.SERVED_UNIT},
        </if>
        <if test=" params.SERVED_ADDRESS != null and params.SERVED_ADDRESS != ''">
            SERVED_ADDRESS = #{params.SERVED_ADDRESS},
        </if>
        <if test=" params.SERVED_FILE != null and params.SERVED_FILE != ''">
            SERVED_FILE = #{params.SERVED_FILE},
        </if>
        <if test=" params.SERVED_SIGN != null and params.SERVED_SIGN != ''">
            SERVED_SIGN = #{params.SERVED_SIGN},
        </if>
        <if test=" params.SERVED_TIME != null and params.SERVED_TIME != ''">
            SERVED_TIME = #{params.SERVED_TIME},
        </if>
        <if test=" params.SEND_SIGN != null and params.SEND_SIGN != ''">
            SEND_SIGN = #{params.SEND_SIGN},
        </if>
        <if test=" params.REASON != null and params.REASON != ''">
            REASON = #{params.REASON},
        </if>
        <if test=" params.MEMO != null and params.MEMO != ''">
            MEMO = #{params.MEMO},
        </if>
        <if test=" params.FILE_PATH != null and params.FILE_PATH != ''">
            FILE_PATH = #{params.FILE_PATH},
        </if>
        ID = #{params.ID}
        WHERE ID = #{params.ID}
    </update>

    <delete id="delLegalReceipt" >
        DELETE
        FROM
        inspection.inspection_legal_receipt
        WHERE 1 = 1
        <if test="params.ID!=null and params.ID != ''">
            AND ID = #{params.ID}
        </if>
        <if test="params.TASK_ID!=null and params.TASK_ID != ''">
            AND TASK_ID = #{params.TASK_ID}
        </if>
    </delete>

</mapper>