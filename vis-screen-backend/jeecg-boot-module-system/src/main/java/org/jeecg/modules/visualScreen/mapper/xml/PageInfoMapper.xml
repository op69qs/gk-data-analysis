<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.visualScreen.mapper.PageInfoMapper">

    <resultMap id="PageInfo" type="org.jeecg.modules.visualScreen.model.PageInfo">
        <result column="id" jdbcType="VARCHAR" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="template" jdbcType="VARCHAR" property="template"/>
        <result column="background_type" jdbcType="VARCHAR" property="background_type"/>
        <result column="content" jdbcType="VARCHAR" property="content"/>
        <result column="thumbnail" jdbcType="VARCHAR" property="thumbnail"/>
        <result column="title_background" jdbcType="VARCHAR" property="title_background"/>
        <result column="add_user" jdbcType="VARCHAR" property="add_user"/>
        <result column="state" jdbcType="VARCHAR" property="state"/>
    </resultMap>

    <select id="getPageInfo" resultMap="PageInfo">
        SELECT
        *
        FROM
        visual_screen.vs_page_info a
        WHERE
        1 = 1
        and a.id = #{params.id}
    </select>

    <select id="getPage" resultType="java.util.HashMap">
        SELECT
        a.*
        FROM visual_screen.vs_page_info a
        where 1=1
        <if test=" params.id != null and params.id != ''">
            and a.id = #{params.id}
        </if>
        <if test=" params.name != null and params.name != ''">
            AND a.name like concat(concat('%',#{params.name}),'%')
        </if>
        <if test=" params.add_user != null and params.add_user != ''">
            and a.add_user = #{params.add_user}
        </if>
        <if test=" params.state != null and params.state != ''">
            and a.state = #{params.state}
        </if>
        ORDER BY a.add_time desc
        LIMIT #{params.rows,jdbcType=INTEGER} OFFSET #{params.page,jdbcType=INTEGER}
    </select>

    <select id="getCount" resultType="java.lang.Integer">
        SELECT
        COUNT(*)
        FROM visual_screen.vs_page_info a
        where 1=1
        <if test=" params.id != null and params.id != ''">
            and a.id = #{params.id}
        </if>
        <if test=" params.name != null and params.name != ''">
            AND a.name like concat(concat('%',#{params.name}),'%')
        </if>
        <if test=" params.add_user != null and params.add_user != ''">
            and a.add_user = #{params.add_user}
        </if>
        <if test=" params.state != null and params.state != ''">
            and a.state = #{params.state}
        </if>
    </select>

    <select id="getAll" resultType="java.util.HashMap">
        SELECT
        a.*
        FROM visual_screen.vs_page_info a
        where 1=1
        <if test=" params.id != null and params.id != ''">
            and a.id = #{params.id}
        </if>
        <if test=" params.name != null and params.name != ''">
            AND a.name like concat(concat('%',#{params.name}),'%')
        </if>
        <if test=" params.add_user != null and params.add_user != ''">
            and a.add_user = #{params.add_user}
        </if>
        <if test=" params.state != null and params.state != ''">
            and a.state = #{params.state}
        </if>
        ORDER BY a.add_time desc
    </select>

    <select id="checkRepeat" resultType="java.util.HashMap">
        SELECT
        *
        FROM visual_screen.vs_page_info a
        where 1=1
        <if test=" params.name != null and params.name != ''">
            and a.name = #{params.name}
        </if>
        <if test=" params.id != null and params.id != ''">
            and a.id != #{params.id}
        </if>
    </select>

    <insert id="add">
        INSERT INTO  visual_screen.vs_page_info
        VALUES
        (
        #{params.id},
        #{params.name},
        #{params.template},
        #{params.background_type},
        #{params.colour},
        #{params.content},
        #{params.thumbnail},
        #{params.title_background},
        #{params.add_user},
        #{params.add_time},
        #{params.state}
        )
    </insert>

    <update id="edit">
        UPDATE visual_screen.vs_page_info SET
        <if test=" params.name != null">
            name = #{params.name},
        </if>
        <if test=" params.template != null">
            template = #{params.template},
        </if>
        <if test=" params.background_type != null">
            background_type = #{params.background_type},
        </if>
        <if test=" params.colour != null">
            colour = #{params.colour},
        </if>
        <if test=" params.content != null">
            content = #{params.content},
        </if>
        <if test=" params.thumbnail != null">
            thumbnail = #{params.thumbnail},
        </if>
        <if test=" params.title_background != null">
            title_background = #{params.title_background},
        </if>
        <if test=" params.state != null">
            state = #{params.state},
        </if>
        id = #{params.id}
        WHERE id = #{params.id}
    </update>

    <delete id="del">
        DELETE
        FROM
        visual_screen.vs_page_info
        WHERE 1 = 1
        <if test="params.id!=null and params.id != ''">
            AND id = #{params.id}
        </if>
    </delete>
</mapper>