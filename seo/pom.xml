			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.bes.appserver</groupId>
			<artifactId>bes-lite-spring-boot-2.x-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
