<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.triber.dwbi</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>deploy-package-assembly</artifactId>
    <packaging>pom</packaging>
    <name>deploy-package-assembly</name>

    <properties>
        <reactor.root.dir>${project.basedir}/..</reactor.root.dir>
        <deploy.package.dir>${reactor.root.dir}/deploy-package</deploy.package.dir>
        <deploy.archive.dir>${reactor.root.dir}</deploy.archive.dir>
        <build.template.dir>${reactor.root.dir}/build</build.template.dir>
        <vis.module.dir>${reactor.root.dir}/vis-screen-backend/jeecg-boot-module-system</vis.module.dir>
    </properties>

    <profiles>
        <profile>
            <id>with-deploy-assembly</id>
            <activation>
                <property>
                    <name>!skip.deploy.assembly</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.gmavenplus</groupId>
                        <artifactId>gmavenplus-plugin</artifactId>
                        <version>1.13.1</version>
                        <executions>
                            <execution>
                                <id>compute-deploy-archive-name</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <configuration>
                                    <scripts>
                                        <script><![CDATA[
                                    def archiveDate = new Date().format('yyyyMMdd')
                                    def projectName = new File(project.properties['reactor.root.dir']).canonicalFile.name
                                    def quotedProjectName = java.util.regex.Pattern.quote(projectName)
                                    def pattern = ~/^${archiveDate}(\d{2})-${quotedProjectName}\.zip$/
                                    def maxSequence = 0

                                    new File(project.properties['deploy.archive.dir']).listFiles()?.findAll { it.isFile() }?.each { file ->
                                        def matcher = (file.name =~ pattern)
                                        if (matcher.matches()) {
                                            def sequence = matcher[0][1] as int
                                            if (sequence > maxSequence) {
                                                maxSequence = sequence
                                            }
                                        }
                                    }

                                    def nextSequence = maxSequence + 1
                                    if (nextSequence > 99) {
                                        throw new IllegalStateException("Archive sequence exceeded 99 for ${archiveDate}-${projectName}")
                                    }

                                    project.properties.setProperty(
                                        'deploy.archive.name',
                                        String.format('%s%02d-%s.zip', archiveDate, nextSequence, projectName)
                                    )
                                        ]]></script>
                                    </scripts>
                                </configuration>
                            </execution>
                            <execution>
                                <id>dedupe-shared-module-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <configuration>
                                    <scripts>
                                        <script><![CDATA[
                                    import java.nio.file.Files
                                    import java.nio.file.StandardCopyOption
                                    import java.security.MessageDigest

                                    def deployLibDir = new File(project.properties['deploy.package.dir'], 'lib')
                                    def commonDir = new File(deployLibDir, 'common')
                                    def moduleNames = [
                                        'dwbi-statistical-analysis',
                                        'dwbi-system-docking',
                                        'fixedReport',
                                        'indicatorsLibv-1.0',
                                        'org-tribe-system',
                                        'seo',
                                        'vis-screen'
                                    ]

                                    def sha1 = { File file ->
                                        def digest = MessageDigest.getInstance('SHA-1')
                                        file.withInputStream { stream ->
                                            byte[] buffer = new byte[8192]
                                            int read
                                            while ((read = stream.read(buffer)) != -1) {
                                                digest.update(buffer, 0, read)
                                            }
                                        }
                                        digest.digest().encodeHex().toString()
                                    }

                                    if (!deployLibDir.exists()) {
                                        println 'No deploy-package/lib directory found, skipping shared lib dedupe.'
                                    } else {
                                        commonDir.mkdirs()
                                        def grouped = [:].withDefault { [] }
                                        moduleNames.each { moduleName ->
                                            def moduleDir = new File(deployLibDir, moduleName)
                                            moduleDir.mkdirs()
                                            moduleDir.listFiles()?.findAll { it.isFile() && it.name.endsWith('.jar') }?.each { file ->
                                                grouped[file.name] << file
                                            }
                                        }

                                        long duplicateBytes = 0L
                                        int sharedJarCount = 0
                                        grouped.each { jarName, files ->
                                            if (files.size() >= 2) {
                                                def digests = files.collect { sha1(it) }.toSet()
                                                if (digests.size() > 1) {
                                                    throw new IllegalStateException("Shared library name collision with different contents: ${jarName}")
                                                }

                                                sharedJarCount++
                                                duplicateBytes += files.tail().sum { it.length() } as long

                                                def commonFile = new File(commonDir, jarName)
                                                Files.move(
                                                    files.first().toPath(),
                                                    commonFile.toPath(),
                                                    StandardCopyOption.REPLACE_EXISTING
                                                )

                                                files.tail().each { duplicate ->
                                                    Files.deleteIfExists(duplicate.toPath())
                                                }
                                            }
                                        }

                                        println "Shared module libs: ${sharedJarCount}, duplicate bytes removed: ${duplicateBytes}"
                                    }
                                        ]]></script>
                                    </scripts>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.codehaus.groovy</groupId>
                                <artifactId>groovy-all</artifactId>
                                <version>2.4.21</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>assemble-deploy-package</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                <delete dir="${deploy.package.dir}/app" quiet="true"/>
                                <delete dir="${deploy.package.dir}/bin" quiet="true"/>
                                <delete dir="${deploy.package.dir}/config" quiet="true"/>
                                <delete dir="${deploy.package.dir}/lib" quiet="true"/>
                                <delete dir="${deploy.package.dir}/bes" quiet="true"/>
                                <delete dir="${deploy.package.dir}/runtime" quiet="true"/>
                                <delete file="${deploy.package.dir}/service.sh" quiet="true"/>
                                <delete file="${deploy.package.dir}/run-with-jdk.sh" quiet="true"/>

                                <mkdir dir="${deploy.package.dir}/app"/>
                                <mkdir dir="${deploy.package.dir}/bin"/>
                                <mkdir dir="${deploy.package.dir}/runtime/logs"/>
                                <mkdir dir="${deploy.package.dir}/runtime/pids"/>
                                <mkdir dir="${deploy.package.dir}/config/dwbi-statistical-analysis"/>
                                <mkdir dir="${deploy.package.dir}/config/dwbi-system-docking"/>
                                <mkdir dir="${deploy.package.dir}/config/fixedReport"/>
                                <mkdir dir="${deploy.package.dir}/config/indicatorsLibv-1.0"/>
                                <mkdir dir="${deploy.package.dir}/config/org-tribe-system"/>
                                <mkdir dir="${deploy.package.dir}/config/seo"/>
                                <mkdir dir="${deploy.package.dir}/config/vis-screen"/>
                                <mkdir dir="${deploy.package.dir}/lib/dwbi-statistical-analysis"/>
                                <mkdir dir="${deploy.package.dir}/lib/dwbi-system-docking"/>
                                <mkdir dir="${deploy.package.dir}/lib/fixedReport"/>
                                <mkdir dir="${deploy.package.dir}/lib/indicatorsLibv-1.0"/>
                                <mkdir dir="${deploy.package.dir}/lib/org-tribe-system"/>
                                <mkdir dir="${deploy.package.dir}/lib/seo"/>
                                <mkdir dir="${deploy.package.dir}/lib/vis-screen"/>
                                <mkdir dir="${deploy.package.dir}/lib/common"/>
                                <mkdir dir="${deploy.package.dir}/bes/vis-screen"/>

                                <copy file="${build.template.dir}/start-all.sh"
                                      tofile="${deploy.package.dir}/bin/start-all.sh"
                                      overwrite="true"/>
                                <copy file="${build.template.dir}/start-all.ps1"
                                      tofile="${deploy.package.dir}/bin/start-all.ps1"
                                      overwrite="true"/>
                                <copy file="${build.template.dir}/service.sh"
                                      tofile="${deploy.package.dir}/service.sh"
                                      overwrite="true"/>
                                <copy file="${build.template.dir}/service.sh"
                                      tofile="${deploy.package.dir}/bin/service.sh"
                                      overwrite="true"/>
                                <copy file="${build.template.dir}/run-with-jdk.sh"
                                      tofile="${deploy.package.dir}/run-with-jdk.sh"
                                      overwrite="true"/>
                                <copy file="${build.template.dir}/run-with-jdk.sh"
                                      tofile="${deploy.package.dir}/bin/run-with-jdk.sh"
                                      overwrite="true"/>

                                <copy todir="${deploy.package.dir}/app" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/dwbi-statistical-analysis/target">
                                        <include name="dwbi-statisticalAnalysis*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <fileset dir="${reactor.root.dir}/dwbi-system-docking/target">
                                        <include name="dwbi-system-docking*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <fileset dir="${reactor.root.dir}/fixedReport/target">
                                        <include name="fixedReport*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <fileset dir="${reactor.root.dir}/indicatorsLibv-1.0/target">
                                        <include name="indicatorsLib*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <fileset dir="${reactor.root.dir}/org-tribe-system/target">
                                        <include name="org-tribe-system*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <fileset dir="${reactor.root.dir}/seo/target">
                                        <include name="seo*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                </copy>

                                <copy todir="${deploy.package.dir}/app" overwrite="true">
                                    <fileset dir="${vis.module.dir}/target">
                                        <include name="jeecg-boot-module-system*.jar"/>
                                        <exclude name="original-*.jar"/>
                                        <exclude name="*-sources.jar"/>
                                        <exclude name="*-javadoc.jar"/>
                                    </fileset>
                                    <regexpmapper from="jeecg-boot-module-system-(.*)\.jar" to="vis-screen-\1.jar"/>
                                </copy>

                                <copy todir="${deploy.package.dir}/config/dwbi-statistical-analysis" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/dwbi-statistical-analysis/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/dwbi-system-docking" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/dwbi-system-docking/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/fixedReport" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/fixedReport/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/indicatorsLibv-1.0" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/indicatorsLibv-1.0/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/org-tribe-system" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/org-tribe-system/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/seo" flatten="true" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/seo/target">
                                        <include name="*.yml"/>
                                        <include name="*.properties"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/config/vis-screen" flatten="true" overwrite="true">
                                    <fileset dir="${vis.module.dir}/src/main/resources">
                                        <include name="application*.yml"/>
                                        <include name="application*.properties"/>
                                        <include name="bootstrap.yml"/>
                                        <include name="logback-spring.xml"/>
                                        <include name="banner.txt"/>
                                    </fileset>
                                </copy>

                                <copy todir="${deploy.package.dir}/lib/dwbi-statistical-analysis" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/dwbi-statistical-analysis/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/dwbi-system-docking" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/dwbi-system-docking/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/fixedReport" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/fixedReport/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/indicatorsLibv-1.0" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/indicatorsLibv-1.0/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/org-tribe-system" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/org-tribe-system/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/seo" flatten="false" overwrite="true">
                                    <fileset dir="${reactor.root.dir}/seo/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                <copy todir="${deploy.package.dir}/lib/vis-screen" flatten="false" overwrite="true">
                                    <fileset dir="${vis.module.dir}/target/lib" erroronmissingdir="false">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>archive-deploy-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                <echo message="Creating deploy archive ${deploy.archive.name}..."/>
                                <delete file="${deploy.archive.dir}/${deploy.archive.name}" failonerror="false"/>
                                <zip destfile="${deploy.archive.dir}/${deploy.archive.name}" encoding="UTF-8">
                                    <zipfileset dir="${deploy.archive.dir}" includes="deploy-package/**"/>
                                </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
